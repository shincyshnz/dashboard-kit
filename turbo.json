{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "design-tokens.json",
    "themes/**/design-tokens.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/design-tokens.json",
        "$TURBO_ROOT$/themes/**/design-tokens.json"
      ],
      "outputs": [
        "dist/**",
        "storybook-static/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}
