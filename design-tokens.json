{
  "$schema": "./packages/tokens/schema/design-tokens.schema.json",
  "$description": "Default Dashboard Kit theme. Cool petrol-blue primary, amber highlight, quiet neutrals.",
  "$extensions": {
    "dev.dashboard-kit": {
      "meta": {
        "name": "Harbor",
        "version": "1.1.0"
      },
      "checks": {
        "contrast": {
          "minimum": 4.5,
          "mode": "error",
          "pairs": []
        }
      }
    }
  },
