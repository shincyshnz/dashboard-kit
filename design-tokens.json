  "radius": {
    "$type": "dimension",
    "$description": "Base corner radius; rounded-sm/md/lg/xl derive from it.",
    "$value": "0.625rem"
  },
  "spacing": {
    "$type": "dimension",
    "$description": "Spacing unit: every spacing utility is a multiple of it (p-4 = 4 × spacing).",
    "$value": "0.25rem"
  },
  "font": {
    "$type": "fontFamily",
    "$description": "Font stacks. Load every family in the app's fonts.css.",
    "sans": {
      "$value": ["Public Sans Variable", "ui-sans-serif", "system-ui", "sans-serif"]
    },
    "heading": {
      "$value": ["Public Sans Variable", "ui-sans-serif", "system-ui", "sans-serif"]
    },
    "mono": {
      "$value": ["JetBrains Mono Variable", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"]
    }
  },
  "fontSize": {
    "$type": "dimension",
    "$description": "Overrides Tailwind's text-* sizes.",
    "xs": {
      "$value": "0.75rem"
    },
    "sm": {
      "$value": "0.875rem"
    },
    "base": {
      "$value": "1rem"
    },
    "lg": {
      "$value": "1.125rem"
    },
    "xl": {
      "$value": "1.25rem"
    },
    "2xl": {
      "$value": "1.5rem"
    },
    "3xl": {
      "$value": "1.875rem"
    }
  },
  "lineHeight": {
    "$type": "dimension",
    "$description": "Line height paired with the fontSize of the same name.",
    "xs": {
      "$value": "1rem"
    },
    "sm": {
      "$value": "1.25rem"
    },
    "base": {
      "$value": "1.5rem"
    },
    "lg": {
      "$value": "1.75rem"
    },
    "xl": {
      "$value": "1.75rem"
    },
    "2xl": {
      "$value": "2rem"
    },
    "3xl": {
      "$value": "2.25rem"
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Elevation: shadow-xs … shadow-xl.",
    "xs": {
      "$value": "0 1px 2px 0 oklch(0.21 0.02 240 / 0.05)"
    },
    "sm": {
      "$value": "0 1px 3px 0 oklch(0.21 0.02 240 / 0.08), 0 1px 2px -1px oklch(0.21 0.02 240 / 0.08)"
    },
    "md": {
      "$value": "0 4px 10px -2px oklch(0.21 0.02 240 / 0.10), 0 2px 4px -2px oklch(0.21 0.02 240 / 0.06)"
    },
    "lg": {
      "$value": "0 12px 24px -6px oklch(0.21 0.02 240 / 0.14), 0 4px 8px -4px oklch(0.21 0.02 240 / 0.08)"
    }
  },
  "duration": {
    "$type": "duration",
    "$description": "Use as duration-(--duration-<name>).",
    "fast": {
      "$value": "120ms"
    },
    "normal": {
      "$value": "200ms"
    },
    "slow": {
      "$value": "320ms"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "$description": "Become ease-<name> utilities.",
    "standard": {
      "$value": [0.2, 0, 0, 1]
    },
    "emphasized": {
      "$value": [0.3, 0, 0, 1.3]
    }
  }
}
