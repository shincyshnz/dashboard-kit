{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "dashboard-kit",
  "homepage": "https://mvp-applications.github.io/dashboard-kit",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "cn() helper",
      "description": "Merges Tailwind classes safely.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Primary action control with variant and size options.",
      "dependencies": [
        "@radix-ui/react-slot",
        "class-variance-authority"
      ],
      "registryDependencies": [
        "@dashboard-kit/utils"
      ],
      "files": [
        {
          "path": "src/components/ui/button.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "card",
      "type": "registry:ui",
      "title": "Card",
      "description": "Surface for grouped content.",
      "registryDependencies": [
        "@dashboard-kit/utils"
      ],
      "files": [
        {
          "path": "src/components/ui/card.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "badge",
      "type": "registry:ui",
      "title": "Badge",
      "description": "Status label. Adds success and warning variants on top of shadcn's.",
      "dependencies": [
        "@radix-ui/react-slot",
        "class-variance-authority"
      ],
      "registryDependencies": [
        "@dashboard-kit/utils"
      ],
      "files": [
        {
          "path": "src/components/ui/badge.tsx",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
