{
  "name": "@dashboard-kit/ui",
  "version": "0.4.0",
  "private": true,
  "description": "Source of the Dashboard Kit shadcn registry. Projects copy these components with `npx shadcn add @dashboard-kit/<name>`.",
  "type": "module",
  "scripts": {
    "registry:check": "node scripts/check-registry.mjs && node scripts/sync-registry.mjs --check",
    "registry:sync": "node scripts/sync-registry.mjs",
    "registry:build": "pnpm registry:check && shadcn build --output ./public/r",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf public/r .turbo",
    "lint": "eslint ."
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.55.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@dashboard-kit/config": "workspace:*",
    "@types/react": "^19.3.0",
    "eslint": "^10.12.0",
    "react": "^19.3.0",
    "shadcn": "^4.20.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
