{
  "name": "@dashboard-kit/ui",
  "version": "0.2.0",
  "private": true,
  "description": "Source of the Dashboard Kit shadcn registry. Projects copy these components with `npx shadcn add @dashboard-kit/<name>`.",
  "type": "module",
  "scripts": {
    "registry:check": "node scripts/check-registry.mjs",
    "registry:build": "pnpm registry:check && shadcn build --output ./public/r",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf public/r .turbo"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@dashboard-kit/config": "workspace:*",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "shadcn": "^4.20.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
