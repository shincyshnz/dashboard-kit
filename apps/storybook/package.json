{
  "name": "@dashboard-kit/storybook",
  "version": "0.1.0",
  "private": true,
  "description": "Component catalogue for the Dashboard Kit registry, with theme and mode switching.",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "storybook build -o storybook-static --quiet",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-stories.mjs",
    "clean": "rm -rf storybook-static .turbo",
    "stories:check": "node scripts/check-stories.mjs"
  },
  "dependencies": {
    "@dashboard-kit/tokens": "workspace:*",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@dashboard-kit/config": "workspace:*",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "storybook": "10.6.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
